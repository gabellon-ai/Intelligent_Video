{
  "name": "Intelligent Video",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && IV_ENABLE_OPTIMIZATION=false ./venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host"
    }
  ],
  "ports": [5173, 8000]
}
